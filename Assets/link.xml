<!-- IL2CPP managed-stripping guards (STORY-6.2 AC5).

     Newtonsoft.Json serializes by reflection, which the linker cannot see:
     Game.Core's MatchSnapshot family travels over the wire via SnapshotCodec,
     and Game.Persistence's PlayerProfile/GameSettings are the save file via
     JsonSaveService. Both assemblies are small; preserve them whole rather
     than chasing individual types as they evolve. The Unity.Services runtime
     assemblies carry their own reflection-built DTOs (auth tokens, session
     models) and are preserved per the story's AC. -->
<linker>
  <assembly fullname="Newtonsoft.Json" preserve="all" />
  <assembly fullname="Game.Core" preserve="all" />
  <assembly fullname="Game.Persistence" preserve="all" />
  <assembly fullname="Unity.Services.Core" preserve="all" />
  <assembly fullname="Unity.Services.Core.Internal" preserve="all" />
  <assembly fullname="Unity.Services.Core.Configuration" preserve="all" />
  <assembly fullname="Unity.Services.Core.Device" preserve="all" />
  <assembly fullname="Unity.Services.Core.Environments" preserve="all" />
  <assembly fullname="Unity.Services.Core.Networking" preserve="all" />
  <assembly fullname="Unity.Services.Core.Registration" preserve="all" />
  <assembly fullname="Unity.Services.Core.Scheduler" preserve="all" />
  <assembly fullname="Unity.Services.Core.Telemetry" preserve="all" />
  <assembly fullname="Unity.Services.Core.Threading" preserve="all" />
  <assembly fullname="Unity.Services.Authentication" preserve="all" />
  <assembly fullname="Unity.Services.Multiplayer" preserve="all" />
  <assembly fullname="Unity.Services.QoS" preserve="all" />
  <assembly fullname="Unity.Services.Wire.Internal" preserve="all" />
</linker>
